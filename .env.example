# ==============================================================================
# MIST Platform - Environment Variables Configuration Template
# ==============================================================================
# COPIE ESTE ARQUIVO PARA '.env' E AJUSTE OS VALORES CONFORME SEU AMBIENTE.
# NUNCA REALIZE O COMMIT DO ARQUIVO '.env' COM CHAVES REAIS!
# ==============================================================================

# Ambiente de Execução: 'development' ou 'production'
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# Segurança & Autenticação (JWT)
# ------------------------------------------------------------------------------
# ATENÇÃO: Em ambiente de produção, esta chave DEVE ser obrigatoriamente
# configurada com ao menos 32 caracteres criptograficamente aleatórios.
# Sugestão para gerar: openssl rand -hex 32
JWT_SECRET_KEY=mist_super_secret_jwt_key_development_secret_32bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# Serviços Internos & Portas
# ------------------------------------------------------------------------------
GATEWAY_PORT=8000
AUTH_SERVICE_PORT=8001
STORE_SERVICE_PORT=8002
LIBRARY_SERVICE_PORT=8003
FRONTEND_PORT=3000

# URLs internas para proxy reverso do API Gateway
AUTH_SERVICE_URL=http://auth-service:8001
STORE_SERVICE_URL=http://store-service:8002
LIBRARY_SERVICE_URL=http://library-service:8003
SOCIAL_SERVICE_URL=http://social-service:8004

# ------------------------------------------------------------------------------
# Persistência de Dados (Auth, Store, Library & Social)
# ------------------------------------------------------------------------------
AUTH_DATABASE_URL=sqlite:///app/data/auth.db
STORE_DATABASE_URL=sqlite:///app/data/store.db
LIBRARY_DATABASE_URL=sqlite:///app/data/library.db
SOCIAL_DATABASE_URL=sqlite:///app/data/social.db

# ------------------------------------------------------------------------------
# Agentes de IA (MIST AI — Gemini / OpenAI / Groq / Mock Local)
# ------------------------------------------------------------------------------
# Provedor padrão: 'auto' (escolhe Gemini -> OpenAI -> Groq -> Mock na ordem das chaves presentes)
# Para forçar modo offline determinístico sem custos: AI_PROVIDER=mock
AI_PROVIDER=auto
AI_TIMEOUT_SECONDS=8.0

# Google Gemini (opcional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenAI (opcional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Groq (opcional)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant