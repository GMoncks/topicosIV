# ==============================================================================
# MIST Platform - Environment Variables Configuration Template
# ==============================================================================
# COPIE ESTE ARQUIVO PARA '.env' E AJUSTE OS VALORES CONFORME SEU AMBIENTE.
# NUNCA REALIZE O COMMIT DO ARQUIVO '.env' COM CHAVES REAIS!
# ==============================================================================

# Ambiente de Execução: 'development' ou 'production'
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# Segurança & Autenticação (JWT)
# ------------------------------------------------------------------------------
# ATENÇÃO: Em ambiente de produção, esta chave DEVE ser obrigatoriamente
# configurada com ao menos 32 caracteres criptograficamente aleatórios.
# Sugestão para gerar: openssl rand -hex 32
JWT_SECRET_KEY=mist_super_secret_jwt_key_development_secret_32bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# Serviços Internos & Portas
# ------------------------------------------------------------------------------
GATEWAY_PORT=8000
AUTH_SERVICE_PORT=8001
FRONTEND_PORT=3000

# URLs internas para proxy reverso do API Gateway
AUTH_SERVICE_URL=http://auth-service:8001
STORE_SERVICE_URL=http://store-service:8002
LIBRARY_SERVICE_URL=http://library-service:8003
SOCIAL_SERVICE_URL=http://social-service:8004

# ------------------------------------------------------------------------------
# Persistência de Dados (Auth Service)
# ------------------------------------------------------------------------------
AUTH_DATABASE_URL=sqlite:///app/data/auth.db